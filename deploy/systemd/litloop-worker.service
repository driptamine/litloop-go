[Unit]
Description=LitLoop background worker
Wants=network-online.target
After=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=litloop
Group=litloop
Environment=REQUIRE_R2_MEDIA=true
EnvironmentFile=/etc/litloop/litloop.env
WorkingDirectory=/var/lib/litloop
StateDirectory=litloop
ExecStart=/usr/local/bin/litloop-worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
