# Copy to /etc/litloop/litloop.env on the VM and replace the values.
# systemd reads this file as root, so it can stay root-owned.
#   sudo install -d -m 0750 /etc/litloop
#   sudo install -m 0600 litloop.env.example /etc/litloop/litloop.env

HTTP_ADDR=127.0.0.1:8000
PUBLIC_URL=https://api.example.com
FRONTEND_URL=https://example.com
CORS_ORIGINS=https://example.com

# openssl rand -hex 32
JWT_SECRET=change-me

# PostgreSQL is required in production; SQLite is for local development only.
DATABASE_URL=postgres://litloop:password@127.0.0.1:5432/litloop?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0

MEDIA_DIR=/var/lib/litloop/media
AUTO_MIGRATE=false
